# SSH server/router connection
SSH_HOST=192.0.2.10
SSH_USER=your_ssh_username
# WifiMon reads SSH_PORT; app/check_state.py reads PORT.
SSH_PORT=22
PORT=22

# Configure SSH_PASSWORD, KEY, or both. KEY is the path to an SSH private key.
SSH_PASSWORD=
KEY=

# Set true only if you intentionally want to accept unknown SSH host keys.
TRUST_NEW_HOST=false

# Router bridge and client network namespaces
BRIDGE=br-lab
PREFIX=client

# Set true to run namespace inspection through sudo -n.
SUDO=false

# Local Docker PostgreSQL. URL-encode reserved characters in username/password.
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5436/WifiMon_db
